# Copy this file to .env and fill in your own values. Never commit the real .env.

# --- YouTube (Google Cloud / YouTube Data API v3) ---
# Path to the OAuth client secret JSON you download from Google Cloud Console.
YOUTUBE_CLIENT_SECRET=client_secret.json

# --- TikTok (TikTok for Developers / Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Public URL hosting oauth_callback.html (a Claude Artifact works well — see README).
# TikTok's Web client rejects localhost/127.0.0.1 redirect URIs outright.
TIKTOK_REDIRECT_URI=
# Filled in automatically by tiktok_auth.py the first time you run it.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# --- Instagram (Unified Login / Facebook Login for Business, graph.facebook.com) ---
# No Facebook Page needed — just a Business-type Meta app and a Business Portfolio.
IG_APP_ID=
IG_APP_SECRET=
# Same public URL hosting oauth_callback.html as above (can reuse the TikTok one).
IG_REDIRECT_URI=
# From Instagram API > API setup with Unified login > your login configuration's id.
IG_CONFIG_ID=
# Filled in automatically by instagram_auth.py. System User token — never expires.
IG_ACCESS_TOKEN=
# The IG professional account id (not the @handle). Shown on the Meta app's
# Instagram API > API setup with Unified login page, next to your account.
IG_BUSINESS_ACCOUNT_ID=
# Instagram's API fetches the video from a URL you host — it does not accept a raw file upload.
# Set this to wherever you host your rendered shorts publicly (S3 bucket, Cloudflare R2, etc.),
# e.g. https://my-bucket.s3.amazonaws.com/shorts
IG_VIDEO_PUBLIC_BASE_URL=
# If you're using a GitHub Pages repo for that hosting (see publish/README.md),
# the local path to its clone. publish_all.py copies+pushes each short here
# before an Instagram post, and prune_media.py removes it again ~12h later.
# Defaults to a sibling "my-media-repo" folder next to this toolkit's checkout.
MEDIA_REPO_DIR=
